---
import Copy from "@components/Copy"

const { name, url, colors, icon: Icon, copyTemplate } = Astro.props

const copyText = copyTemplate
  .replace("{name}", name)
  .replace("{url}", url)

const lightColor = typeof colors === "object" && "light" in colors ? colors.light : colors.text
const darkColor = typeof colors === "object" && "dark" in colors ? colors.dark : colors.text
---

<div 
  class="group relative w-full flex items-center justify-between rounded-2xl border border-black/10 dark:border-white/15 bg-white/80 dark:bg-slate-900/60 backdrop-blur-xl shadow-sm hover:shadow-xl dark:shadow-[0_4px_20px_rgba(0,0,0,0.4)] hover:border-[var(--brandLight)] dark:hover:border-[var(--brandDark)] transition-all duration-300 hover:-translate-y-0.5 overflow-hidden"
  style={`--brandLight: ${lightColor}; --brandDark: ${darkColor};`}
>
  <div class="absolute inset-0 bg-gradient-to-r from-[var(--brandLight)]/10 dark:from-[var(--brandDark)]/15 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

  <a 
    href={url} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="flex-1 flex items-center gap-3.5 px-4 py-3.5 font-geist text-base font-semibold text-slate-800 dark:text-slate-100 z-10"
  >
    <div 
      class="p-2 rounded-xl bg-black/5 dark:bg-white/10 border border-black/5 dark:border-white/10 group-hover:scale-105 group-hover:bg-[var(--brandLight)]/15 dark:group-hover:bg-[var(--brandDark)]/20 transition-all duration-300 text-slate-800 dark:text-slate-100 group-hover:text-[var(--brandLight)] dark:group-hover:text-[var(--brandDark)]"
    >
      <Icon class="size-5 shrink-0 transition-colors duration-200 fill-current" />
    </div>

    <span class="tracking-wide text-slate-800 dark:text-slate-100 group-hover:text-[var(--brandLight)] dark:group-hover:text-[var(--brandDark)] transition-colors">
      {name}
    </span>
  </a>

  <div class="pr-3 z-10 flex items-center justify-center">
    <Copy copyText={copyText} client:load />
  </div>
</div>