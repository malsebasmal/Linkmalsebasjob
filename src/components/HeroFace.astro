---
import { Image } from "astro:assets"
---

<div class="w-full flex flex-col items-center justify-center text-center gap-4">
  
  <div class="relative">
    <div class="absolute -inset-1 rounded-full bg-emerald-500/10 dark:bg-emerald-400/10 blur-xl"></div>

    <div class="relative size-28 sm:size-32 rounded-full overflow-hidden border border-black/15 dark:border-white/15 p-1 bg-white/40 dark:bg-black/30 backdrop-blur-md shadow-xs">
      <Image 
        src="https://github.com/malsebasmal.png" 
        alt="Antonio Maldonado E." 
        width={300} 
        height={300} 
        loading="eager"
        class="w-full h-full object-cover rounded-full" 
      />
    </div>
  </div>

  <div class="w-full flex flex-col items-center gap-1.5 font-geist">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white transition-colors duration-300">
      Antonio Maldonado E.
    </h1>
    
    <div class="flex items-center gap-2 font-kode text-xs tracking-wider text-slate-500 dark:text-slate-400">
      <span class="text-slate-800 dark:text-slate-200 uppercase font-medium tracking-widest">
        SOFTWARE · WEB · LINUX
      </span>
    </div>
  </div>

</div>