---
import Share from "@components/Share"
import ColorTheme from "@components/ColorTheme"
---

<header class="w-full max-w-xl mx-auto px-2 md:px-4 pt-6 pb-6">
  <nav class="w-full flex items-center justify-between py-2.5 px-4 rounded-2xl border border-black/10 dark:border-white/15 bg-white/80 dark:bg-slate-900/60 backdrop-blur-xl shadow-sm dark:shadow-[0_4px_20px_rgba(0,0,0,0.4)]">
    
    <div class="flex items-center gap-2 font-kode text-xs text-slate-700 dark:text-slate-300 font-semibold">
      <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>ONLINE</span>
    </div>

    <ul class="flex items-center gap-1">
      <Share client:load />
      <ColorTheme client:load />
    </ul>
  </nav>
</header>